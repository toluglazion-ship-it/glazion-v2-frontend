{
  "name": "@glazion/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Glazion mobile app — UMF calculator, tile search and chat",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:mock": "cross-env EXPO_PUBLIC_USE_MOCKS=true expo start",
