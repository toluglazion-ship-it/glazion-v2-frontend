    "web": "expo start --web",
    "web:mock": "cross-env EXPO_PUBLIC_USE_MOCKS=true expo start --web",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
